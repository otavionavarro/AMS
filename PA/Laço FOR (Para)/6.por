programa {
  funcao inicio() {
    inteiro habitantes
    real kwh, codigo, consumomes
    escreva("Digite a quantidade de habitantes de uma cidade: ")
    leia(habitantes)
    escreva("Digite o valor do kwh: ")
    leia(kwh)
    escreva("Qual o seu consumo do mês: ")
    leia(consumomes)
    escreva("1-Residencial")
    escreva("2-Comercial")
    escreva("3-Industrial")
    escreva("escolha o número do seu código: ")
    leia(codigo)

    se(codigo == 1) {
      escreva("")
    }
    
  }
}
